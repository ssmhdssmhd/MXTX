# ==================================================================
# 超级嗅探 - 环境变量配置示例
# 使用方法：
#   1) 复制此文件为 .env 并修改其中的值（若用 pm2 / docker 直接注入也可）
#   2) 启动时 export $(cat .env | grep -v '^#' | xargs) && node node.js
#      或使用 source；或使用 dotenv 类的工具自行加载
# ==================================================================

# ============================================================
# 一、服务基本配置
# ============================================================

# 服务监听端口（默认 1314，兼容旧变量 PORT）
MX_PORT=1314

# 服务监听主机：0.0.0.0=所有网卡可访问，127.0.0.1=仅本地可访问
MX_HOST=0.0.0.0

# ============================================================
# 二、后台管理账号密码（非常推荐生产环境设置）
#   设置后访问 /admin 会弹 Basic Auth 登录框
# ============================================================

# 后台管理员用户名
MX_ADMIN_USER=admin

# 后台管理员密码（请务必修改为强密码！）
MX_ADMIN_PASS=please_change_me_123456

# ============================================================
# 三、浏览器 / Puppeteer 配置
# ============================================================

# Chrome/Chromium 可执行文件路径（默认 ./chrome-linux64/chrome，兼容 CHROME_PATH）
# 系统 Chrome 示例：MX_CHROME_PATH=/usr/bin/google-chrome-stable
MX_CHROME_PATH=./chrome-linux64/chrome

# 是否无头模式：true=后台无窗口（默认），false=显示窗口（调试用）
MX_CHROME_HEADLESS=true

# 浏览器实例池大小（1~3 推荐，默认 1；实例越多并发越强，但占内存越大）
MX_BROWSER_POOL_SIZE=1

# 单个浏览器最多复用多少个 Page（默认 8，防止单浏览器 Page 太多卡死）
MX_PAGE_POOL_SIZE=8

# Chrome 额外启动参数（JSON 数组字符串，高级用户用）
# MX_CHROME_ARGS=["--proxy-server=http://127.0.0.1:7890","--user-data-dir=/tmp/chrome-profile"]

# ============================================================
# 四、嗅探 / 解析参数
# ============================================================

# 单次解析总超时（毫秒），含页面加载 + 等待时间（默认 30000）
MX_PARSE_TIMEOUT=30000

# 页面加载完成后额外等待时间（毫秒），用于等待动态加载的视频地址
# 注意：MX_EARLY_RETURN=true 时，一旦捕获到 m3u8 会立即跳过等待
MX_EXTRA_WAIT=2000

# 找到即返回开关：一旦捕获到 m3u8 立即返回结果（性能优化核心，默认 true）
MX_EARLY_RETURN=true

# 自定义 User-Agent（伪装成普通浏览器）
MX_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# 视口宽度（像素）
MX_VIEWPORT_WIDTH=1280

# 视口高度（像素）
MX_VIEWPORT_HEIGHT=720

# 是否从文本类响应体（JS/JSON/HTML）中扫描 m3u8 地址（默认 true，部分站点必须开启）
MX_SNIFF_RESPONSE_BODY=true

# 是否扫描页面中所有 iframe 内容（默认 true）
MX_SNIFF_IFRAME=true

# ============================================================
# 五、LRU 结果缓存配置
#   相同 URL 在 TTL 内直接返回缓存，不用重新开浏览器解析
# ============================================================

# 是否启用解析结果缓存（默认 true）
MX_CACHE_ENABLE=true

# 缓存 TTL（秒），默认 1800 秒 = 30 分钟
MX_CACHE_TTL=1800

# 最大缓存条目数（防内存无限增长，超出淘汰最久未使用）
MX_CACHE_MAX=500

# ============================================================
# 六、并发控制（防 OOM / 防 Chrome 卡死）
# ============================================================

# 最大同时解析数量（默认 5；超过的请求进入队列等待）
MX_MAX_CONCURRENT=5

# 请求排队超时（毫秒）：队列里等待超过这个时间直接报错「请求排队超时」
MX_REQUEST_QUEUE_TIMEOUT=90000

# ============================================================
# 七、在线更新源配置
# ============================================================

# GitHub 仓库用户名（默认 ssmhdssmhd，兼容旧 GITHUB_OWNER）
MX_GITHUB_OWNER=ssmhdssmhd

# GitHub 仓库名（默认 MXTX，兼容旧 GITHUB_REPO）
MX_GITHUB_REPO=MXTX

# GitHub Token（可选；私有仓库需要，或突破 API 60次/小时限流）
# MX_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# 下载更新时使用的代理（国内访问 GitHub 慢时推荐）
# MX_PROXY=http://127.0.0.1:7890

# ============================================================
# 八、PHP 前端（api.php）专属配置
#   若 PHP 无法读取系统环境变量，请在 php-fpm.conf / Nginx fastcgi_param 中设置
#   例如 Nginx：fastcgi_param MX_PLAYER_HOST "http://127.0.0.1:1314";
# ============================================================

# Node.js 解析服务地址（兼容旧 PLAYER_HOST）
MX_PLAYER_HOST=http://127.0.0.1:1314

# PHP cURL 总超时（秒，默认 30）
MX_PHP_TIMEOUT=30

# PHP cURL 连接超时（秒，默认 3）
MX_PHP_CONNECT_TIMEOUT=3

# PHP 层是否启用本地文件缓存（1=开 0=关）
MX_PHP_CACHE_ENABLE=1

# PHP 层缓存 TTL（秒，默认 1800）
MX_PHP_CACHE_TTL=1800

# PHP 层缓存目录（默认当前目录下 .mx_cache）
# MX_PHP_CACHE_DIR=/tmp/super-sniffer-php-cache

# PHP 是否校验 SSL 证书（1=开 0=关，内网/自签证书时关）
MX_PHP_SSL_VERIFY=0
