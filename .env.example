# ============================================================================
# 超级嗅探 (Super Sniffer) v2.1 环境变量示例
# ============================================================================
# 说明：
#   所有变量均支持「MX_ 前缀」优先。
#   例如同时设置 PORT=8080 和 MX_PORT=9090，则实际生效 MX_PORT=9090。
#   这样可以避免与系统或其他应用的同名变量冲突。
#
# 使用方法：
#   1) 复制本文件为 .env 后按需修改（若你的启动器会自动加载 .env）
#   2) 或在 shell 中 export MX_PORT=8080 形式导出
#   3) 或在 systemd / docker 等启动脚本中按相同 Key 注入
# ============================================================================

# ============================================================================
# 【第 1 节】服务类 MX_ 变量
# ============================================================================

# Node.js 解析服务监听端口
# 默认: 1314
MX_PORT=1314

# Node.js 解析服务绑定地址（0.0.0.0 允许外部访问；127.0.0.1 仅本机）
# 默认: 0.0.0.0
MX_HOST=0.0.0.0

# PHP 前端 api.php 调用 Node.js 服务时使用的地址（PHP 端与 Node 端共用此变量）
# 若 PHP 与 Node 不同机，请填写 Node 服务的实际可达地址
# 默认: http://122.51.166.115:1314
MX_PLAYER_HOST=http://122.51.166.115:1314

# ============================================================================
# 【第 2 节】后台管理类 MX_ 变量
# ============================================================================

# 管理后台 Basic Auth 用户名
# 访问 /admin、/admin/sniff 以及所有 /admin/api/* 均需要此账号密码
# 默认: admin
MX_ADMIN_USER=admin

# 管理后台 Basic Auth 密码
# ⚠️  生产环境请务必修改为强密码
# 默认: admin123
MX_ADMIN_PASS=admin123

# ============================================================================
# 【第 3 节】浏览器与 Puppeteer 类 MX_ 变量
# ============================================================================

# Chrome / Chromium 可执行文件路径
# 项目自带 chrome-linux64/，若想使用系统已安装浏览器请修改此路径
# 默认: ./chrome-linux64/chrome
MX_CHROME_PATH=./chrome-linux64/chrome

# 单次解析页面加载的超时时间（毫秒）
# 页面结构复杂或网络较慢时可适当调大
# 默认: 30000
MX_PARSE_TIMEOUT=30000

# 页面 load 事件触发后额外等待时间（毫秒）
# 某些站点视频地址会延迟注入，需给 JS 执行留时间
# 默认: 3000
MX_EXTRA_WAIT=3000

# ============================================================================
# 【第 4 节】缓存类 MX_ 变量（v2+ LRU 缓存）
# ============================================================================

# 是否启用 LRU 缓存（1=启用 0=禁用）
# 命中缓存直接返回结果，跳过 Puppeteer 启动
# 默认: 1
MX_CACHE_ENABLE=1

# LRU 缓存最大条目数（超过自动淘汰最久未使用）
# 默认: 1000
MX_CACHE_MAX=1000

# 单条缓存过期时间（秒）
# 默认: 3600（1 小时）
MX_CACHE_TTL=3600

# ============================================================================
# 【第 5 节】并发控制类 MX_ 变量（v2+ 信号量 / EarlyReturn）
# ============================================================================

# 最大并发解析请求数（信号量控制）
# 超过会排队等待，避免 Puppeteer 开太多导致 OOM
# 默认: 10
MX_SEMAPHORE_MAX=10

# 是否启用 EarlyReturn 提前返回（1=启用 0=禁用）
# 在网络请求拦截层捕获到 m3u8 地址后立即返回，不等待整页加载完毕
# 默认: 1
MX_EARLY_RETURN=1

# ============================================================================
# 【第 6 节】更新模块类 MX_ 变量（update.js 在线更新）
# ============================================================================

# GitHub 仓库所有者（用户名或组织名）
# 默认: ssmhdssmhd
MX_GITHUB_OWNER=ssmhdssmhd

# GitHub 仓库名
# 默认: MXTX
MX_GITHUB_REPO=MXTX

# GitHub Personal Access Token（可选）
# 访问私有仓库、或提高 GitHub API 速率限制时需要
# 默认: （留空）
MX_GITHUB_TOKEN=

# 代理服务器地址（用于下载 GitHub Release / GitHub API）
# 格式示例:
#   HTTP 代理:  http://127.0.0.1:7890
#   SOCKS5 代理: socks5://127.0.0.1:7891
# 默认: （留空=不走代理）
MX_PROXY=

# ============================================================================
# 【第 7 节】（保留，未来扩展位；当前为「万能嗅探」前的过渡占位）
# ============================================================================
# 注：历史上的「嗅探」指 Puppeteer 单页 m3u8 嗅探（第 3、4、5 节参数），
#     此处预留给后续自定义提取策略扩展使用。当前版本可全部留空。
# ============================================================================

# ============================================================================
# 【第 8 节】万能嗅探 MX_ 变量（v2.1 新增）★ 重点
# ============================================================================
# 万能嗅探 = 18 个内置第三方 VIP/通用解析接口 + 并发 + 去重 + 排名
#
# 18 个内置接口（完整清单，MX_SNIFF_PROVIDERS 逗号分隔选择）：
#   ┌────┬───────────────┬──────────────────────┬─────────┐
#   │ 编号│ 接口ID        │ 名称                 │ 提取类型 │
#   ├────┼───────────────┼──────────────────────┼─────────┤
#   │  1 │ p01_jsonplayer│ JSONPlayer 通用解析   │ json    │
#   │  2 │ p02_m3u8direct│ M3U8 Direct API      │ m3u8    │
#   │  3 │ p03_vipfast   │ VIP 快解析 v1        │ json    │
#   │  4 │ p04_parseryun │ 云解析 Pro           │ hybrid  │
#   │  5 │ p05_superparse│ SuperParse 智能解析   │ json    │
#   │  6 │ p06_playerapi │ PlayerAPI 开放接口    │ m3u8    │
#   │  7 │ p07_vipjieda  │ VIP 解答组            │ json    │
#   │  8 │ p08_blparse   │ 蓝光云解析            │ hybrid  │
#   │  9 │ p09_qqvideo   │ 腾讯专属解析          │ json    │
#   │ 10 │ p10_iqiyiparse│ 爱奇艺专属解析        │ json    │
#   │ 11 │ p11_youkup    │ 优酷极速解析          │ json    │
#   │ 12 │ p12_mgtvparse │ 芒果解析站            │ m3u8    │
#   │ 13 │ p13_leparse   │ 乐视/搜狐混合         │ hybrid  │
#   │ 14 │ p14_bilibp    │ B 站非正式解析        │ src     │
#   │ 15 │ p15_douyinp   │ 抖音/短视频解析       │ json    │
#   │ 16 │ p16_ksplay    │ 快手解析              │ json    │
#   │ 17 │ p17_globalp   │ 海外平台通吃          │ hybrid  │
#   │ 18 │ p18_embyext   │ Emby/Jellyfin 外部   │ m3u8    │
#   └────┴───────────────┴──────────────────────┴─────────┘
# 提取类型说明：
#   json   = 接口返回 JSON，按约定字段（data.url / data.playUrl / url ...）取
#   m3u8   = 响应正文本身是 m3u8 文本或包含 .m3u8? 完整链接，正则直接提
#   src    = 提取 HTML 中 <video>/<source> 的 src 属性直链
#   hybrid = 混合策略：JSON→m3u8 正则→iframe→src，多轮命中即返回
# ============================================================================

# 是否启用万能嗅探（1=启用 0=完全关闭 /sniff 与 /admin/sniff 路由）
# 默认: 1
MX_SNIFF_ENABLE=1

# 单个第三方接口的超时时间（毫秒）
# 超时视为 failCode=4008
# 默认: 15000
MX_SNIFF_TIMEOUT=15000

# 万能嗅探最大并发数（同时发起多少个接口请求）
# 服务器带宽/出口 IP 有限时可适当降到 8~12
# 默认: 18
MX_SNIFF_CONCURRENCY=18

# 是否对返回结果按 m3u8 URL 去重（1=启用 0=关闭）
# 多接口命中相同地址时只保留最快的一条
# 默认: 1
MX_SNIFF_DEDUP=1

# 结果排序方式：
#   speed = 按响应速度（latencyMs 升序），最快的在 results[0] 顶部
#   count = 按命中次数（hitCount 降序），多接口都命中的在顶部
# 默认: speed
MX_SNIFF_RANK=speed

# 最大返回 results 条目数（去重+排序后取前 N 条）
# 默认: 10
MX_SNIFF_MAX_RESULTS=10

# 单接口失败重试次数（0=不重试，1=失败再试1次，以此类推）
# 对偶尔抖动的接口较友好，但会延长整体耗时
# 默认: 1
MX_SNIFF_RETRY=1

# 是否对命中的每一条 m3u8 地址做 HEAD 请求可达性检查（1=启用 0=关闭）
# 开启后能筛掉一批接口返回的死链，但会增加 ~20%~50% 额外耗时
# 默认: 1
MX_SNIFF_HEADCHECK=1

# 本次启用的万能嗅探接口 ID 列表（逗号分隔）
# 留空 = 使用全部 18 个内置接口。
# 示例：仅启用国内低延迟 6 个接口 → p01,p03,p05,p07,p09,p10
# 默认: （留空=全部）
MX_SNIFF_PROVIDERS=

# ============================================================================
# 【第 9 节】PHP 专属 MX_ 变量（api.php 使用，Node 端可不配置）
# ============================================================================

# PHP cURL 调用 Node.js 解析服务的地址（与第 1 节 MX_PLAYER_HOST 同源，
# 若已在第 1 节设置可不重复设置；此处重复列出便于 PHP 运维单独管理）
# 默认: http://122.51.166.115:1314
# MX_PLAYER_HOST=http://122.51.166.115:1314

# PHP cURL 超时时间（秒）
# 对应 curl_setopt CURLOPT_TIMEOUT
# 默认: 30
MX_PHP_TIMEOUT=30

# PHP cURL 是否校验 SSL 证书（1=校验 0=不校验）
# 自签名 / 测试环境建议 0；生产环境推荐 1
# 对应 curl_setopt CURLOPT_SSL_VERIFYPEER / CURLOPT_SSL_VERIFYHOST
# 默认: 0
MX_PHP_SSL_VERIFY=0
