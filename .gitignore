# 依赖
node_modules/

# Chrome 浏览器（体积较大，从 chrome-linux64.tar.xz 解压）
chrome-linux64/

# 浏览器压缩包（体积较大，仅内置在分发 zip 中）
chrome-linux64.tar.xz
chrome-linux64.tar.gz
chrome-linux64.tgz
chrome-linux64.zip

# 日志
*.log
npm-debug.log*

# 运行时配置（在线更新源等，由后台生成）
update-config.json

# 更新备份
backup/

# 环境变量
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp

# PHP 层本地缓存（api.php 默认写在 ./.mx_cache）
.mx_cache/

# 临时文件
tmp/
temp/
